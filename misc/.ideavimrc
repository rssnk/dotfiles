map Q gq

set guicursor=""

set nu
set relativenumber

set tabstop=4
set softtabstop=4
set shiftwidth=4
set expandtab

set smartindent

set wrap

set nohlsearch
set incsearch
set ignorecase

set scrolloff = 8
set signcolumn = "yes"
set isfname:append("@-@")

set updatetime = 50

let mapleader = " "

-- pasting without loosing yanked content
xmap <leader>P "_d

-- yanking in system clipboard
n <leader>y "+y
vmap <leader>y "+y
nmap <leader>Y "+Y

-- pasting from system clipboard
nmap <leader>p "+p
vmap <leader>p "+p

-- deleting in void reg
vmap <leader>d "_d
nmap <leader>d "_d

nmap gD <Action>(GotoDefinition)
nmap gd <Action>(GotoDeclaration)
nmap gI <Action>(GotoImplementation)
nmap K <Action>(ShowHoverInfo)

nmap <leader>rn <Action>(RenameElement)
imap <C-d> <Action>(ShowHoverInfo)
